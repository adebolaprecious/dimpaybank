<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
    }

    .wrapper {
      width: 100%;
      padding: 20px 0;
    }

    .container {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    /* HEADER */
    .header {
      background: linear-gradient(135deg, #0f172a, #2563eb);
      padding: 30px 20px;
      text-align: center;
      color: white;
    }

    .header h1 {
      margin: 0;
      font-size: 24px;
    }

    .header p {
      margin: 8px 0 0;
      font-size: 14px;
      opacity: 0.9;
    }

    /* CONTENT */
    .content {
      padding: 30px 20px;
      color: #333;
      text-align: center;
    }

    .content h2 {
      margin-bottom: 10px;
      font-size: 20px;
      color: #111827;
    }

    .content p {
      font-size: 14px;
      color: #6b7280;
      line-height: 1.6;
    }

    /* BUTTON */
    .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 24px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: bold;
    }

    .btn:hover {
      background: #1d4ed8;
    }
    .otp-box{
  background:#f3f4f6;
  padding:20px;
  border-radius:10px;
  text-align:center;
  margin-top:20px;
}

.otp-box h1{
  letter-spacing:10px;
  color:#2563eb;
  font-size:32px;
}

    /* CARD */
    .card {
      margin: 20px;
      padding: 20px;
      background: #f9fafb;
      border-radius: 10px;
      text-align: left;
      font-size: 14px;
      color: #374151;
    }

    /* FOOTER */
    .footer {
      background: #f3f4f6;
      padding: 15px;
      text-align: center;
      font-size: 12px;
      color: #6b7280;
    }

    /* MOBILE */
    @media (max-width: 600px) {
      .header h1 {
        font-size: 20px;
      }

      .content {
        padding: 20px 15px;
      }

      .card {
        margin: 15px;
      }
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="container">

      <!-- HEADER -->
      <div class="header">
        <h1>Welcome to <%= companyName %> 💙</h1>
        <p>Your digital banking experience starts here</p>
      </div>

      <!-- CONTENT -->
      <div class="content">
        <h2>Hello, <%= name %> 👋</h2>

        <p>
          Your account has been successfully created.
          You now have access to your wallet, transactions, and secure banking features.
        </p>
        <div class="otp-box">
  <h2>Your OTP Code</h2>
  <h1><%= otp %></h1>
</div>

        <!-- INFO CARD -->
        <div class="card">
          <p><strong>Status:</strong> Active Account</p>
          <p><strong>Security:</strong> 256-bit encrypted banking system</p>
          <p><strong>Support:</strong> 24/7 customer assistance</p>
        </div>

        <a href="#" class="btn">Go to Dashboard</a>
      </div>

      <!-- FOOTER -->
      <div class="footer">
        <p>
          © <%= new Date().getFullYear() %> <%= companyName %> — All rights reserved.
        </p>
      </div>

    </div>
  </div>
</body>
</html>